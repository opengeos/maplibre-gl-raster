{
  "name": "maplibre-gl-raster",
  "version": "0.9.0",
  "description": "A MapLibre GL JS plugin for visualizing local and remote raster datasets (GeoTIFF/COG)",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./style.css": "./dist/maplibre-gl-raster.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:geolibre",
    "build:lib": "tsc -p tsconfig.json && vite build",
    "build:geolibre": "vite build --config vite.geolibre.config.ts",
    "build:examples": "vite build --config vite.examples.config.ts",
    "package:geolibre": "npm run build:geolibre && node scripts/package-geolibre-plugin.mjs",
    "serve:geolibre": "node scripts/serve-geolibre-plugin.mjs",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "geolibre",
    "maplibre",
    "maplibre-gl",
    "map",
    "plugin",
    "control",
    "raster",
    "geotiff",
    "cog",
    "deck.gl",
    "react",
    "typescript"
  ],
  "author": "Qiusheng Wu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengeos/maplibre-gl-raster.git"
  },
  "dependencies": {
    "@chunkd/middleware": "^11.3.0",
    "@chunkd/source": "^11.4.0",
    "@chunkd/source-http": "^11.4.0",
    "@cogeotiff/core": "^9.5.0",
    "@developmentseed/deck.gl-geotiff": "^0.7.0",
    "@developmentseed/deck.gl-raster": "0.7.0",
    "@developmentseed/geotiff": "^0.7.0",
    "@developmentseed/proj": "^0.7.0",
    "proj4": "^2.20.8"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@deck.gl/mesh-layers": "^9.3.2",
    "@luma.gl/core": "^9.3.3",
    "@luma.gl/shadertools": "^9.3.3",
    "cog-tiler-wasm": ">=0.2.0",
    "maplibre-gl": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "cog-tiler-wasm": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/geo-layers": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@deck.gl/mesh-layers": "^9.3.2",
    "@eslint/js": "^10.0.1",
    "@luma.gl/core": "^9.3.3",
    "@luma.gl/shadertools": "^9.3.3",
    "@microsoft/api-extractor": "^7.58.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.8",
    "cog-tiler-wasm": "^0.2.1",
    "eslint": "^10.4.1",
    "geotiff": "^2.1.3",
    "geotiff-geokeys-to-proj4": "^2024.4.13",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^5.24.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8",
    "whitebox-wasm": "^0.4.0"
  }
}
